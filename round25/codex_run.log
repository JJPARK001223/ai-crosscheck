  $lines = @(& $pdfTool -f 1 -l 1 -layout -enc UTF-8 $pdfFile.FullName - 2>$null)
  $headIdx = -1; $col = 0
  for ($i=0; $i -lt $lines.Count; $i++) {
    $m = [regex]::Match($lines[$i], '"'(?:A\\s+B\\s+S\\s+T\\s+R\\s+A\\s+C\\s+T|Abstract\\s*:?)')
    if ("'$m.Success) { $headIdx=$i; $col=$m.Index; break }
  }
  if ($headIdx -lt 0) { "NO HEAD $idx $($pdfFile.Name)"; continue }
  $parts = [System.Collections.Generic.List[string]]::new()
  $headLine = $lines[$headIdx].Substring($col)
  $headLine = [regex]::Replace($headLine, '"'"'^(?:A'"\\s+B\\s+S\\s+T\\s+R\\s+A\\s+C\\s+T|Abstract)\\s*:?[ \\t]*', '')
  if ("'$headLine.Trim()) { $parts.Add($headLine.Trim()) }
  for ($i=$headIdx+1; $i -lt $lines.Count; $i++) {
    if ($lines[$i] -match '"'"'^'"\\s*1\\.?\\s*Introduction\\b') { break }
    if ("'$lines[$i].Length -le $col) { $parts.Add('"''); continue }
    "'$piece = $lines[$i].Substring($col).Trim()
    if ($piece -match '"'"'^Keywords?'"\\s*:?' -or "'$piece -match '"'"'^Novelty and significance'"\\b') { break }
    "'$parts.Add($piece)
  }
  $candidate = ($parts -join "`n").Trim()
  $candidate = [regex]::Replace($candidate, '"'([\\p{L}\\p{N}])[-\\u00AD]\\s*\\r?\\n\\s*([\\p{Ll}])', '"'$1-$2'"')
  "'$words = [regex]::Split($candidate, '"'\\s+') | Where-Object { "'$_ }
  "=====INDEX $idx COUNT=$($words.Count) $($pdfFile.Name)====="
  [regex]::Replace($candidate, '"'\\s+', ' ')
